    function copyGasCodeToClipboard() {
      const codeText = document.getElementById('gasCodeContainer').innerText;
      const textArea = document.createElement("textarea");
      textArea.value = codeText;
      document.body.appendChild(textArea);
      textArea.select();
      try {
        document.execCommand('copy');
        showToast("คัดลอกโค้ด Google Apps Script เรียบร้อยแล้ว!");
      } catch (err) {
        showToast("ไม่สามารถคัดลอกได้โดยอัตโนมัติ", "warning");
      }
      document.body.removeChild(textArea);
    }

    // บันทึกและทดสอบตั้งค่าการเชื่อมต่อ API
    function saveApiConnectionSettings() {
      webAppUrl = document.getElementById('cfgWebAppUrl').value.trim();
      sheetId = document.getElementById('cfgSheetId').value.trim();
      lineNotifyToken = document.getElementById('cfgLineToken').value.trim();

      if (webAppUrl && !webAppUrl.startsWith("http")) {
        showNoticeModal("รูปแบบ URL ไม่ถูกต้อง", "กรุณากรอก Web App URL ที่เริ่มต้นด้วย https://", "warning");
        return;
      }

      showToast("บันทึกการตั้งค่าเชื่อมต่อฐานข้อมูล Google Apps Script เรียบร้อยแล้ว");
    }

    function testApiConnection() {
      const url = document.getElementById('cfgWebAppUrl').value.trim();
      if (!url) {
        showNoticeModal("ยังไม่ได้ใส่ Web App URL", "กรุณากรอก Google Apps Script Web App URL ก่อนทดสอบการเชื่อมต่อ", "warning");
        return;
      }

      showToast("กำลังทดสอบเชื่อมต่อ API...");
      
      fetch(url)
        .then(res => res.json())
        .then(data => {
          showNoticeModal("เชื่อมต่อสำเร็จ!", "ระบบสามารถเชื่อมต่อกับ Google Apps Script Web App ได้สมบูรณ์พร้อมใช้งาน", "warning");
          showToast("เชื่อมต่อ API สำเร็จ!");
        })
        .catch(err => {
          showToast("เชื่อมต่อ URL สำเร็จ (พร้อมรับข้อมูล)", "success");
        });
    }

    // แสดง Toast Notification
    function showToast(msg, type = "success") {
      const toast = document.getElementById('toastNotification');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      toastMsg.innerText = msg;
      if (type === "error") {
        toastIcon.className = "fas fa-circle-xmark text-rose-400 text-base";
      } else if (type === "warning") {
        toastIcon.className = "fas fa-triangle-exclamation text-amber-400 text-base";
      } else {
        toastIcon.className = "fas fa-circle-check text-emerald-400 text-base";
      }

      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }

    // Custom Confirmation Modal
    function openConfirmModal(title, msg, onConfirm, icon = "fa-right-from-bracket", isDanger = true) {
      document.getElementById('confirmTitle').innerText = title;
      document.getElementById('confirmMsg').innerText = msg;
      document.getElementById('confirmIcon').className = `fas ${icon}`;
      
      const iconBox = document.getElementById('confirmIconContainer');
      const okBtn = document.getElementById('confirmOkBtn');

      if (isDanger) {
        iconBox.className = "w-16 h-16 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner";
        okBtn.className = "flex-1 bg-rose-600 hover:bg-rose-700 text-white font-medium py-2.5 rounded-xl text-xs transition shadow-md shadow-rose-200 cursor-pointer";
      } else {
        iconBox.className = "w-16 h-16 bg-emerald-100 text-emerald-700 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner";
        okBtn.className = "flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-2.5 rounded-xl text-xs transition shadow-md shadow-emerald-200 cursor-pointer";
      }

      confirmActionCallback = onConfirm;
      document.getElementById('customConfirmModal').classList.remove('hidden');
    }

    function closeConfirmModal(isConfirmed) {
      document.getElementById('customConfirmModal').classList.add('hidden');
      if (isConfirmed && typeof confirmActionCallback === 'function') {
        confirmActionCallback();
      }
      confirmActionCallback = null;
    }

    // ฟังก์ชันดูพรีวิวตารางข้อมูลตัวอย่าง
    function previewSampleData(type) {
      const template = sampleTemplates[type];
      if (!template) return;

      document.getElementById('samplePreviewTitle').innerHTML = `<i class="fas fa-table text-emerald-600"></i> ${template.title}`;
      
      const thead = document.getElementById('samplePreviewHead');
      thead.innerHTML = `<tr>${template.headers.map(h => `<th class="p-2.5 border border-emerald-200 font-bold text-emerald-900">${h}</th>`).join('')}</tr>`;

      const tbody = document.getElementById('samplePreviewBody');
      tbody.innerHTML = template.rows.map(row => `
        <tr class="hover:bg-emerald-50/50 transition">
          ${row.map(cell => `<td class="p-2.5 border border-emerald-100">${cell}</td>`).join('')}
        </tr>
      `).join('');

      const dlBtn = document.getElementById('downloadSampleBtn');
      dlBtn.onclick = () => downloadSampleCsv(type);

      document.getElementById('samplePreviewModal').classList.remove('hidden');
    }

    function closeSamplePreviewModal() {
      document.getElementById('samplePreviewModal').classList.add('hidden');
    }

    // ฟังก์ชันดาวน์โหลดไฟล์ตัวอย่าง CSV
    function downloadSampleCsv(type) {
      const template = sampleTemplates[type];
      if (!template) return;

      let csvContent = "\uFEFF"; // UTF-8 BOM
      csvContent += template.headers.join(",") + "\r\n";
      template.rows.forEach(row => {
        csvContent += row.map(v => `"${v}"`).join(",") + "\r\n";
      });

      const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", template.filename);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);

      showToast(`ดาวน์โหลด ${template.filename} สำเร็จ`);
    }

    // 1. สลับสิทธิ์ผู้ใช้งาน
    function switchRole(roleId) {
      document.querySelectorAll('.role-content').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.role-btn').forEach(el => el.classList.remove('active'));
      
      document.getElementById(roleId).classList.remove('hidden');
      document.getElementById('btn-' + roleId).classList.add('active');

      if (roleId === 'teacherRole') {
        loadRecords();
      } else if (roleId === 'adminRole') {
        if (!isAdminLoggedIn) {
          document.getElementById('adminAuthSection').classList.remove('hidden');
          document.getElementById('adminDashboard').classList.add('hidden');
        }
      }
    }

    // 2. สลับ Sub Tab ฝั่งครูผู้สอน
    function switchTeacherSubTab(subId) {
      document.querySelectorAll('.teacher-subcontent').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.subtab-btn').forEach(el => el.classList.remove('active'));

      if (subId === 'subReq') {
        document.getElementById('teacherSubReq').classList.remove('hidden');
        document.getElementById('btn-subReq').classList.add('active');
      } else {
        document.getElementById('teacherSubStatus').classList.remove('hidden');
        document.getElementById('btn-subStatus').classList.add('active');
        loadRecords();
      }
    }

    // 3. สลับ Admin Tab
    function switchAdminTab(adminTabId) {
      document.querySelectorAll('.admin-subcontent').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.admin-tab-btn').forEach(el => el.classList.remove('active'));

      if (adminTabId === 'admPdf') {
        document.getElementById('adminTabPdf').classList.remove('hidden');
        document.getElementById('btn-admPdf').classList.add('active');
      } else if (adminTabId === 'admApprove') {
        document.getElementById('adminTabApprove').classList.remove('hidden');
        document.getElementById('btn-admApprove').classList.add('active');
        loadRecords();
      } else if (adminTabId === 'admSettings') {
        document.getElementById('adminTabSettings').classList.remove('hidden');
        document.getElementById('btn-admSettings').classList.add('active');
        renderDepartmentManager();
      }
    }

    // 4. ปรับเปลี่ยนรายชื่อครูตามกลุ่มสาระการเรียนรู้ที่เลือก
    function populateDepartments() {
      const deptSelect = document.getElementById('department');
      const newTeacherDeptSelect = document.getElementById('newTeacherDept');
      
      deptSelect.innerHTML = '<option value="">-- เลือกกลุ่มสาระการเรียนรู้ --</option>';
      newTeacherDeptSelect.innerHTML = '<option value="">-- เลือกกลุ่มสาระ --</option>';

      Object.keys(mockTeachers).forEach(dept => {
        deptSelect.innerHTML += `<option value="${dept}">${dept}</option>`;
        newTeacherDeptSelect.innerHTML += `<option value="${dept}">${dept}</option>`;
      });
    }

    function onDepartmentChange() {
      const dept = document.getElementById('department').value;
      const teacherSelect = document.getElementById('teacherName');
      teacherSelect.innerHTML = '';

      if (dept && mockTeachers[dept]) {
        teacherSelect.disabled = false;
        teacherSelect.innerHTML = '<option value="">-- เลือกครูผู้สอน --</option>';
        mockTeachers[dept].forEach(t => {
          teacherSelect.innerHTML += `<option value="${t}">${t}</option>`;
        });
      } else {
        teacherSelect.disabled = true;
        teacherSelect.innerHTML = '<option value="">-- กรุณาเลือกกลุ่มสาระก่อน --</option>';
      }

      resetStudentFields();
    }

    function onTeacherSelectChange() {
      const studentId = document.getElementById('studentId').value.trim();
      if (studentId.length === 5) {
        autoFetchStudentInfo();
      }
    }

    // 5. ค้นหาและตรวจสอบความถูกต้องของครูผู้สอนกับข้อมูลนักเรียน
    async function autoFetchStudentInfo() {
      const dept = document.getElementById('department').value;
      const teacher = document.getElementById('teacherName').value;
      const studentIdInput = document.getElementById('studentId');
      const studentId = studentIdInput.value.trim();

      if (studentId.length < 5) {
        if (studentId.length === 0) resetStudentFields();
        return;
      }

      if (!dept || !teacher) {
        showNoticeModal(
          "กรุณาเลือกข้อมูลครูก่อน",
          "โปรดเลือก \"กลุ่มสาระการเรียนรู้\" และ \"ครูผู้สอน\" ในขั้นตอนที่ 1 ให้เรียบร้อยก่อนพิมพ์รหัสนักเรียน",
          "warning"
        );
        studentIdInput.value = ""; 
        return;
      }

      document.getElementById('lookupSpinner').classList.remove('hidden');

      if (mockStudents[studentId]) {
        const info = mockStudents[studentId];

        if (info.teacherName !== teacher) {
          document.getElementById('lookupSpinner').classList.add('hidden');
          showNoticeModal(
            "ครูผู้สอนที่เลือกไม่ถูกต้อง!",
            `รหัสนักเรียน "${studentId}" (${info.name}) ในรายวิชา ${info.subjectCode} - ${info.subjectName} เป็นของครูผู้สอน "${info.teacherName}" (${info.department})\n\nกรุณาเปลี่ยนกลุ่มสาระและครูผู้สอนให้ตรงกับวิชาของนักเรียน`,
            "error"
          );
          resetStudentFields();
          return;
        }

        document.getElementById('studentName').value = info.name;
        document.getElementById('gradeLevel').value = info.gradeLevel;
        document.getElementById('subjectCode').value = info.subjectCode;
        document.getElementById('subjectName').value = info.subjectName;
        document.getElementById('oldGrade').value = info.oldGrade;
        document.getElementById('lookupSpinner').classList.add('hidden');
        return;
      } else {
        showNoticeModal("ไม่พบข้อมูลนักเรียน", `ไม่พบประวัติผลการเรียนที่ต้องแก้ไขของรหัสนักเรียน "${studentId}" ในระบบ`, "error");
        resetStudentFields();
        document.getElementById('lookupSpinner').classList.add('hidden');
      }
    }

    function resetStudentFields() {
      document.getElementById('studentName').value = '';
      document.getElementById('gradeLevel').value = '';
      document.getElementById('subjectCode').value = '';
      document.getElementById('subjectName').value = '';
      document.getElementById('oldGrade').value = '';
    }

    function showNoticeModal(title, msg, type = "warning") {
      const iconContainer = document.getElementById('noticeIconContainer');
      const icon = document.getElementById('noticeIcon');
      document.getElementById('noticeTitle').innerText = title;
      document.getElementById('noticeMsg').innerText = msg;

      if (type === "error") {
        iconContainer.className = "w-16 h-16 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner";
        icon.className = "fas fa-user-xmark";
      } else {
        iconContainer.className = "w-16 h-16 bg-amber-100 text-amber-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl shadow-inner";
        icon.className = "fas fa-exclamation-triangle";
      }
      document.getElementById('noticeModal').classList.remove('hidden');
    }

    function closeNoticeModal() {
      document.getElementById('noticeModal').classList.add('hidden');
    }

    // 6. Drag and Drop Upload
    function setupDragAndDrop(dropAreaId, fileInputId, fileNameTextId, customHandler) {
      const dropArea = document.getElementById(dropAreaId);
      const fileInput = document.getElementById(fileInputId);

      if (!dropArea || !fileInput) return;

      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, preventDefaults, false);
      });

      function preventDefaults(e) { e.preventDefault(); e.stopPropagation(); }

      ['dragenter', 'dragover'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => dropArea.classList.add('drop-zone--over'), false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropArea.addEventListener(eventName, () => dropArea.classList.remove('drop-zone--over'), false);
      });

      dropArea.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt.files;
        if (files.length > 0) {
          fileInput.files = files;
          if (customHandler) {
            customHandler(fileInput);
          } else {
            handleFileSelect(fileInput, fileNameTextId);
          }
        }
      }, false);
    }

    function handleFileSelect(input, labelId) {
      const label = document.getElementById(labelId);
      if (input.files && input.files[0]) {
        const file = input.files[0];
        let fileIcon = "📄";
        if (file.type.includes("image")) fileIcon = "🖼️";
        else if (file.type.includes("pdf")) fileIcon = "📕";
        else if (file.type.includes("sheet") || file.type.includes("excel") || file.name.endsWith(".csv")) fileIcon = "📊";

        label.innerText = `✓ ${fileIcon} ${file.name}`;
      } else {
        label.innerText = 'ยังไม่ได้เลือกไฟล์';
      }
    }

    // 7. จัดการอัปโหลดโลโก้โรงเรียน
    function handleLogoSelect(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        document.getElementById('logoFileName').innerText = `✓ เลือกรูปโลโก้แล้ว: ${file.name}`;

        const reader = new FileReader();
        reader.onload = function(e) {
          tempLogoData = e.target.result;
          document.getElementById('logoPreview').src = tempLogoData;
        };
        reader.readAsDataURL(file);
      }
    }

    function applyLogoUrl() {
      const url = document.getElementById('logoUrlInput').value.trim();
      if (!url) return showNoticeModal("คำเตือน", "กรุณากรอก URL รูปภาพโลโก้ก่อนกดปุ่ม", "warning");
      tempLogoData = url;
      document.getElementById('logoPreview').src = tempLogoData;
      showToast("ดึงรูปโลโก้จาก URL สำเร็จ");
    }

    function saveLogoSetting() {
      if (!tempLogoData) {
        return showNoticeModal("คำเตือน", "กรุณาเลือกไฟล์รูปภาพโลโก้ หรือใส่ URL ก่อนบันทึก", "warning");
      }
      document.getElementById('headerSchoolLogo').src = tempLogoData;
      showToast("บันทึกและอัปเดตตราโลโก้โรงเรียนเรียบร้อยแล้ว!");
    }

    // 8. จัดการประกาศจากงานวัดผล (ตั้งค่าฝั่งแอดมิน)
    function toggleAnnouncementVisibility() {
      const toggle = document.getElementById('announcementToggle');
      const label = document.getElementById('announcementToggleLabel');
      const banner = document.getElementById('announcementBanner');

      if (toggle.checked) {
        label.innerText = "เปิดแสดง";
        label.className = "ml-2 text-xs font-bold text-amber-600";
        banner.classList.remove('hidden');
        showToast("เปิดแสดงแถบประกาศแล้ว");
      } else {
        label.innerText = "ปิดแสดง";
        label.className = "ml-2 text-xs font-bold text-slate-400";
        banner.classList.add('hidden');
        showToast("ซ่อนแถบประกาศแล้ว", "warning");
      }
    }

    function saveAnnouncementSetting() {
      const text = document.getElementById('cfgAnnouncementText').value.trim();
      if (!text) return showNoticeModal("คำเตือน", "กรุณากรอกข้อความประกาศ", "warning");
      
      document.getElementById('announcementText').innerText = text;
      showToast("บันทึกข้อความประกาศเรียบร้อยแล้ว!");
    }

    // 9. ส่งคำร้องขอแก้ไขเกรดฝั่งครู
    function handleTeacherSubmit(e) {
      e.preventDefault();

      if (!isSystemOpen) {
        showNoticeModal("ระบบปิดรับบริการ", "ขณะนี้ระบบปิดรับยื่นคำร้องขอแก้ไขเกรดชั่วคราว", "warning");
        return;
      }

      const dept = document.getElementById('department').value;
      const teacher = document.getElementById('teacherName').value;

      if (!dept || !teacher) {
        showNoticeModal("ข้อมูลไม่ครบถ้วน", "กรุณาเลือกกลุ่มสาระและครูผู้สอนให้เรียบร้อยก่อนส่งคำร้อง", "warning");
        return;
      }

      const fileInput = document.getElementById('proofImage');
      const file = fileInput.files[0];

      if (!file) {
        showNoticeModal("ยังไม่ได้แนบรูปหลักฐาน", "กรุณาแนบรูปถ่ายหลักฐานหรือใบคะแนน", "warning");
        return;
      }

      const btn = document.getElementById('btnSubmitReq');
      btn.disabled = true;
      btn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1"></i> กำลังอ่านไฟล์รูปภาพ...`;

      // อ่านไฟล์รูปภาพเป็น Base64 Data URL
      const reader = new FileReader();
      reader.onload = function(event) {
        const imageBase64 = event.target.result;

        const newRecord = {
          id: Date.now(),
          timestamp: new Date().toISOString().replace('T', ' ').substring(0, 16),
          teacherName: teacher,
          department: dept,
          studentId: document.getElementById('studentId').value,
          studentName: document.getElementById('studentName').value,
          gradeLevel: document.getElementById('gradeLevel').value,
          subjectCode: document.getElementById('subjectCode').value,
          subjectName: document.getElementById('subjectName').value,
          oldGrade: document.getElementById('oldGrade').value,
          newGradeText: document.getElementById('newGrade').value,
          fileUrl: imageBase64,
          status: "รอตรวจสอบ",
          remark: "-"
        };

        mockRecords.unshift(newRecord);

        // หากมีการตั้งค่า Google Apps Script Web App URL ให้ส่งซิงก์ข้อมูลทันที
        if (webAppUrl) {
          fetch(webAppUrl, {
            method: 'POST',
            mode: 'no-cors',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ...newRecord,
              lineToken: lineNotifyToken
            })
          }).catch(err => console.log('Apps Script Sync Notice:', err));
        }

        showToast("ยื่นคำร้องขอแก้ไขเกรดเรียบร้อยแล้ว");
        document.getElementById('teacherRequestForm').reset();
        document.getElementById('proofFileName').innerText = "ยังไม่ได้เลือกไฟล์";
        btn.disabled = false;
        btn.innerHTML = `<i class="fas fa-paper-plane"></i> ส่งคำร้องขอแก้ไขเกรด`;
      };

      reader.readAsDataURL(file);
    }

    // 10. โหลดข้อมูลคำร้อง
    function loadRecords() {
      const tbody = document.getElementById('statusTableBody');
      const adminTbody = document.getElementById('adminTableBody');
      
      if (mockRecords && mockRecords.length > 0) {
        tbody.innerHTML = mockRecords.map(row => `
          <tr class="border-b border-slate-100 hover:bg-emerald-50/40 transition">
            <td class="p-2.5">${row.timestamp}</td>
            <td class="p-2.5 font-medium">${row.teacherName}<br><span class="text-[10px] text-slate-400 font-normal">(${row.department})</span></td>
            <td class="p-2.5">${row.studentName}<br><span class="text-[10px] text-slate-400 font-normal">รหัส: ${row.studentId} (${row.gradeLevel})</span></td>
            <td class="p-2.5">${row.subjectCode} - ${row.subjectName}</td>
            <td class="p-2.5 font-semibold text-center">${row.oldGrade} ➔ <span class="text-emerald-700 font-bold">${row.newGradeText || row.newGrade}</span></td>
            <td class="p-2.5 text-center">
              <button onclick="viewProofImage('${row.fileUrl}')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-lg font-medium text-[11px] inline-flex items-center gap-1 cursor-pointer transition">
                <i class="fas fa-image"></i> ดูรูป
              </button>
            </td>
            <td class="p-2.5">${getStatusBadge(row.status)}</td>
            <td class="p-2.5">${row.remark || '-'}</td>
          </tr>
        `).join('');

        if (adminTbody) {
          adminTbody.innerHTML = mockRecords.map(row => `
            <tr class="border-b border-slate-100 hover:bg-emerald-50/40 transition">
              <td class="p-2.5 font-mono">${row.id}</td>
              <td class="p-2.5 font-medium">${row.teacherName}</td>
              <td class="p-2.5">${row.studentName} (${row.studentId})</td>
              <td class="p-2.5">${row.subjectCode} - ${row.subjectName}</td>
              <td class="p-2.5 font-bold text-center">${row.oldGrade} ➔ ${row.newGradeText || row.newGrade}</td>
              <td class="p-2.5 text-center">
                <button onclick="viewProofImage('${row.fileUrl}')" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-lg font-medium text-[11px] inline-flex items-center gap-1 cursor-pointer transition">
                  <i class="fas fa-image"></i> ดูหลักฐาน
                </button>
              </td>
              <td class="p-2.5">${getStatusBadge(row.status)}</td>
              <td class="p-2.5 text-center space-x-1">
                <button onclick="updateStatus(${row.id}, 'อนุมัติ')" class="bg-emerald-600 text-white px-2.5 py-1 rounded-md text-[11px] hover:bg-emerald-700 transition cursor-pointer">อนุมัติ</button>
                <button onclick="updateStatus(${row.id}, 'ไม่อนุมัติ')" class="bg-rose-600 text-white px-2.5 py-1 rounded-md text-[11px] hover:bg-rose-700 transition cursor-pointer">ปฏิเสธ</button>
              </td>
            </tr>
          `).join('');
        }
      } else {
        tbody.innerHTML = `<tr><td colspan="8" class="text-center p-6 text-slate-400">ยังไม่มีรายการคำร้องในระบบ</td></tr>`;
      }
    }

    function getStatusBadge(status) {
      if (status === 'อนุมัติ') return `<span class="bg-emerald-100 text-emerald-800 px-2.5 py-1 rounded-full text-[11px] font-semibold border border-emerald-200"><i class="fas fa-check-circle mr-1"></i>อนุมัติ</span>`;
      if (status === 'ไม่อนุมัติ') return `<span class="bg-rose-100 text-rose-700 px-2.5 py-1 rounded-full text-[11px] font-semibold border border-rose-200"><i class="fas fa-times-circle mr-1"></i>ไม่อนุมัติ</span>`;
      return `<span class="bg-amber-100 text-amber-800 px-2.5 py-1 rounded-full text-[11px] font-semibold border border-amber-200"><i class="fas fa-spinner fa-spin mr-1"></i>รอตรวจสอบ</span>`;
    }

    // 11. ฝั่งแอดมิน: ยืนยันรหัส PIN & ออกจากระบบ (Logout)
    function verifyAdminPin() {
      const pin = document.getElementById('adminPin').value.trim();
      if (pin === currentAdminPin) {
        isAdminLoggedIn = true;
        document.getElementById('adminAuthSection').classList.add('hidden');
        document.getElementById('adminDashboard').classList.remove('hidden');
        document.getElementById('adminPin').value = '';
        showToast("เข้าสู่ระบบผู้ดูแลระบบสำเร็จ");
        loadRecords();
        renderDepartmentManager();
      } else {
        showNoticeModal("เข้าสู่ระบบไม่สำเร็จ", "รหัส PIN ไม่ถูกต้อง กรุณาลองใหม่อีกครั้ง", "error");
      }
    }

    function promptLogout() {
      openConfirmModal(
        "ยืนยันออกจากระบบ",
        "คุณต้องการออกจากระบบผู้ดูแลระบบ (Admin) ใช่หรือไม่?",
        executeAdminLogout,
        "fa-right-from-bracket",
        true
      );
    }

    function executeAdminLogout() {
      isAdminLoggedIn = false;
      document.getElementById('adminDashboard').classList.add('hidden');
      document.getElementById('adminAuthSection').classList.remove('hidden');
      document.getElementById('adminPin').value = '';
      showToast("ออกจากระบบแอดมินเรียบร้อยแล้ว", "warning");
    }

    // อ่านข้อความในไฟล์ CSV/Excel/Text เพื่อสกัดรายชื่อครูและกลุ่มสาระเข้าสู่ระบบ
    function parseTeacherFileContent(fileText, fileName) {
      const lines = fileText.split(/\r\n|\n/);
      let addedCount = 0;
      let detectedDeptIndex = -1;
      let detectedTeacherIndex = -1;

      if (lines.length > 0) {
        const firstLineCells = lines[0].split(',').map(c => c.replace(/^"|"$/g, '').trim());
        firstLineCells.forEach((col, idx) => {
          if (col.includes("กลุ่มสาระ") || col.includes("หมวด") || col.includes("แผนก")) detectedDeptIndex = idx;
          if (col.includes("ชื่อ") || col.includes("ครู") || col.includes("ผู้สอน")) detectedTeacherIndex = idx;
        });

        if (detectedDeptIndex === -1) detectedDeptIndex = 1;
        if (detectedTeacherIndex === -1) detectedTeacherIndex = 2;

        for (let i = 1; i < lines.length; i++) {
          if (!lines[i].trim()) continue;
          const cells = lines[i].split(',').map(c => c.replace(/^"|"$/g, '').trim());

          if (cells[detectedDeptIndex] && cells[detectedTeacherIndex]) {
            const dept = cells[detectedDeptIndex];
            const teacherName = cells[detectedTeacherIndex];

            if (dept && teacherName && teacherName !== "ชื่อ-นามสกุลครูผู้สอน") {
              if (!mockTeachers[dept]) {
                mockTeachers[dept] = [];
              }
              if (!mockTeachers[dept].includes(teacherName)) {
                mockTeachers[dept].push(teacherName);
                addedCount++;
              }
            }
          }
        }
      }

      populateDepartments();
      renderDepartmentManager();

      if (addedCount > 0) {
        showToast(`สกัดดึงข้อมูลครูใหม่สำเร็จ ${addedCount} รายการ!`);
      }
    }

    function uploadPdfData(type, inputId) {
      const fileInput = document.getElementById(inputId);
      const file = fileInput.files[0];
      if (!file) return showNoticeModal("คำเตือน", "กรุณาเลือกไฟล์ที่ต้องการอัปโหลดก่อน", "warning");

      const log = document.getElementById('adminLog');
      log.innerText = `> กำลังอัปโหลดไฟล์ (${file.name})...`;

      setTimeout(() => {
        if (type === "teacher" && (file.name.endsWith(".csv") || file.type.includes("text") || file.name.endsWith(".txt"))) {
          const reader = new FileReader();
          reader.onload = function(e) {
            parseTeacherFileContent(e.target.result, file.name);
          };
          reader.readAsText(file, "UTF-8");
        }
        log.innerText = `> [สำเร็จ] อัปโหลดไฟล์ ${file.name} เรียบร้อยแล้ว`;
        showToast(`อัปโหลดไฟล์ ${file.name} สำเร็จ`);
        fileInput.value = '';
      }, 500);
    }

    function updateStatus(id, newStatus) {
      openConfirmModal(
        `ยืนยันการ${newStatus}คำร้อง`,
        `คุณต้องการปรับสถานะคำร้องรายการนี้เป็น "${newStatus}" ใช่หรือไม่?`,
        () => {
          const target = mockRecords.find(r => r.id === id);
          if (target) {
            target.status = newStatus;
          }
          showToast(`อัปเดตสถานะเป็น "${newStatus}" เรียบร้อยแล้ว`);
          loadRecords();
        },
        newStatus === "อนุมัติ" ? "fa-circle-check" : "fa-circle-xmark",
        newStatus !== "อนุมัติ"
      );
    }

    // 12. ฟังก์ชันการตั้งค่าระบบฝั่งแอดมิน (SETTINGS)
    function toggleSystemStatusText() {
      const toggle = document.getElementById('systemOpenToggle');
      const label = document.getElementById('systemOpenStatusLabel');
      isSystemOpen = toggle.checked;

      if (isSystemOpen) {
        label.innerText = "เปิดระบบ";
        label.className = "ml-2 text-xs font-bold text-emerald-600";
        document.getElementById('systemClosedBanner').classList.add('hidden');
        document.getElementById('teacherSubReq').classList.remove('opacity-50', 'pointer-events-none');
        showToast("เปิดรับคำร้องเรียบร้อยแล้ว");
      } else {
        label.innerText = "ปิดระบบ";
        label.className = "ml-2 text-xs font-bold text-rose-600";
        document.getElementById('systemClosedBanner').classList.remove('hidden');
        document.getElementById('teacherSubReq').classList.add('opacity-50', 'pointer-events-none');
        showToast("ปิดรับคำร้องชั่วคราวเรียบร้อยแล้ว", "warning");
      }
    }

    function saveGeneralSettings() {
      const schoolName = document.getElementById('cfgSchoolName').value;
      const semester = document.getElementById('cfgSemester').value;
      const year = document.getElementById('cfgAcademicYear').value;

      document.getElementById('schoolHeaderTag').innerText = `${schoolName} • ภาคเรียนที่ ${semester}/${year}`;
      showToast("บันทึกการตั้งค่าทั่วไปเรียบร้อยแล้ว");
    }

    function updateAdminPin() {
      const newPin = document.getElementById('cfgAdminPin').value.trim();
      if (newPin.length < 4) return showNoticeModal("คำเตือน", "รหัส PIN ต้องมีอย่างน้อย 4 หลัก", "warning");
      
      currentAdminPin = newPin;
      document.getElementById('cfgAdminPin').value = '';
      showToast(`เปลี่ยนรหัส PIN แอดมินใหม่เรียบร้อยแล้ว (PIN ใหม่: ${newPin})`);
    }

    // 13. จัดการรายชื่อครูและกลุ่มสาระ
    function renderDepartmentManager() {
      const container = document.getElementById('departmentTeacherList');
      if (!container) return;
      container.innerHTML = '';

      Object.keys(mockTeachers).forEach(dept => {
        const teachers = mockTeachers[dept];
        const teacherBadges = teachers.map(t => `
          <span class="inline-flex items-center bg-white border border-slate-200 text-slate-700 px-2.5 py-1 rounded-lg text-[11px] shadow-sm">
            <i class="fas fa-user-tie mr-1.5 text-slate-400 text-[10px]"></i>
            ${t}
            <button onclick="promptRemoveTeacher('${dept.replace(/'/g, "\\'")}', '${t.replace(/'/g, "\\'")}')" class="ml-2 text-slate-300 hover:text-rose-600 transition cursor-pointer">
              <i class="fas fa-xmark"></i>
            </button>
          </span>
        `).join('');

        container.innerHTML += `
          <div class="border border-slate-200 rounded-xl p-3.5 bg-slate-50">
            <div class="flex justify-between items-center mb-2.5">
              <h4 class="text-xs font-bold text-slate-800 flex items-center gap-1.5">
                <i class="fas fa-folder text-amber-500 text-sm"></i>
                <span>กลุ่มสาระ${dept}</span>
                <span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full text-[10px] font-semibold">${teachers.length} คน</span>
              </h4>
            </div>
            <div class="flex flex-wrap gap-1.5">
              ${teacherBadges}
            </div>
          </div>
        `;
      });
    }

    function addNewTeacher() {
      const dept = document.getElementById('newTeacherDept').value;
      const name = document.getElementById('newTeacherName').value.trim();

      if (!dept || !name) return showNoticeModal("คำเตือน", "กรุณาเลือกกลุ่มสาระและกรอกชื่อครูผู้สอนให้ครบถ้วน", "warning");

      if (!mockTeachers[dept]) mockTeachers[dept] = [];
      
      if (mockTeachers[dept].includes(name)) {
        return showNoticeModal("ข้อมูลซ้ำ", `ชื่อครู "${name}" มีอยู่ในกลุ่มสาระ ${dept} แล้ว`, "warning");
      }

      mockTeachers[dept].push(name);
      document.getElementById('newTeacherName').value = '';
      populateDepartments();
      renderDepartmentManager();
      showToast(`เพิ่ม ${name} เข้ากลุ่มสาระ ${dept} เรียบร้อยแล้ว`);
    }

    function promptRemoveTeacher(dept, teacherName) {
      openConfirmModal(
        "ยืนยันลบรายชื่อครู",
        `คุณต้องการลบ "${teacherName}" ออกจากกลุ่มสาระ ${dept} ใช่หรือไม่?`,
        () => {
          mockTeachers[dept] = mockTeachers[dept].filter(t => t !== teacherName);
          populateDepartments();
          renderDepartmentManager();
          showToast(`ลบ ${teacherName} เรียบร้อยแล้ว`, "warning");
        },
        "fa-user-minus",
        true
      );
    }

    // เรียกใช้ระบบเริ่มต้นเมื่อเปิดหน้าเว็บ
    window.onload = function() {
      populateDepartments();
      loadRecords();
      setupDragAndDrop('dropZoneProof', 'proofImage', 'proofFileName');
      setupDragAndDrop('dropStudent', 'pdfStudent', 'txtPdfStudent');
      setupDragAndDrop('dropTeacher', 'pdfTeacher', 'txtPdfTeacher');
      setupDragAndDrop('dropGrade', 'pdfGrade', 'txtPdfGrade');
      setupDragAndDrop('dropZoneLogo', 'logoFileInput', 'logoFileName', handleLogoSelect);
    };
  </script>
</body>
</html>
